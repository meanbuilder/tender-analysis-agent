def create_tender_workbook(
    result: TenderAnalysisResult,
    boq_items: list[BOQItem] | None = None,
) -> Workbook:
    """Create the five-sheet tender workbook in memory."""
    workbook = Workbook()

    summary = workbook.active
    if summary is None:
        raise RuntimeError("Unable to create the tender summary worksheet.")
    summary.title = "Tender Summary"
    _append_excel_row(summary, HEADERS["summary"])
    for row in _summary_rows(result):
        _append_excel_row(summary, row)
    _style_sheet(summary)

    _add_table_sheet(
        workbook,
        "BOQ and Technical Items",
        HEADERS["boq"],
        _boq_rows(boq_items or []),
    )
    _add_table_sheet(
        workbook,
        "Compliance and Risk Register",
        HEADERS["risks"],
        _risk_rows(result),
    )
    _add_table_sheet(
        workbook,
        "Evidence and Exceptions",
        HEADERS["evidence"],
        _evidence_rows(result),
    )
    _add_table_sheet(
        workbook,
        "Make in India - Annexure 8",
        HEADERS["annexure"],
        _annexure_rows(result),
    )
    return workbook


def export_tender_workbook(
    result: TenderAnalysisResult,
    output_path: str | Path,
    boq_items: list[BOQItem] | None = None,
) -> Path:
    """Save the workbook to disk and return its destination path."""
    path = Path(output_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    workbook = create_tender_workbook(result, boq_items)
    workbook.save(path)
    return path


def workbook_to_bytes(
    result: TenderAnalysisResult,
    boq_items: list[BOQItem] | None = None,
) -> bytes:
    """Serialize the workbook for an in-memory download."""
