MISSING_VALUE = "Not available in uploaded documents."
REVIEW_REQUIRED_HEADER = "Review Required"
REVIEW_REASON_HEADER = "Review Reason"

# Excel/openpyxl rejects these XML control characters in cell strings.
# Keep valid whitespace, multilingual text, and other Unicode characters.
_ILLEGAL_EXCEL_CHARACTERS = re.compile(r"[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]")


def display_missing_value(value: object) -> object:
    """Replace missing values with an explicit report status."""
    if value is None:
        return MISSING_VALUE
    if isinstance(value, str) and not value.strip():
        return MISSING_VALUE
    return value


def _sanitize_excel_value(value: object) -> object:
    """Remove Excel-incompatible control characters from string values."""
    if isinstance(value, str):
        return _ILLEGAL_EXCEL_CHARACTERS.sub("", value)
    return value


def _append_excel_row(
    worksheet: Worksheet,
    values: Iterable[object],
) -> None:
    """Append a sanitized row, marking missing values explicitly."""
    worksheet.append([
        _sanitize_excel_value(display_missing_value(value))
        for value in values
    ])


