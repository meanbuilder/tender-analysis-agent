def _source_pages(finding: ParameterFinding) -> str:
    """Format unique source references without losing document names."""
    references = (
        f"{item.filename}, page {item.page_number}" for item in finding.evidence
    )
    return "; ".join(dict.fromkeys(references))


def _source_documents(finding: ParameterFinding) -> str:
    """Return unique source filenames in evidence order."""
    filenames = (item.filename for item in finding.evidence)
    return "; ".join(dict.fromkeys(filenames))


def _style_sheet(worksheet: Worksheet) -> None:
    """Apply readable headers, wrapping, filters, and column widths."""
    header_fill = PatternFill("solid", fgColor="176B70")
    header_font = Font(color="FFFFFF", bold=True)

    worksheet.freeze_panes = "A2"
    worksheet.auto_filter.ref = worksheet.dimensions
    worksheet.sheet_view.showGridLines = False

    for cell in worksheet[1]:
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(
            vertical="center",
            horizontal="left",
            wrap_text=True,
        )

    worksheet.row_dimensions[1].height = 32

    for column_cells in worksheet.columns:
        if not column_cells:
            continue
        column_index = column_cells[0].column
        if column_index is None:
            continue
        column_letter = get_column_letter(column_index)

        max_length = max(
            (len(str(cell.value)) for cell in column_cells if cell.value is not None),
            default=10,
        )
        worksheet.column_dimensions[column_letter].width = min(
            max(max_length + 2, 14),
            55,
        )

        for cell in column_cells[1:]:
            cell.alignment = Alignment(vertical="top", wrap_text=True)


def _add_table_sheet(
    workbook: Workbook,
    title: str,
    headers: Iterable[object],
    rows: Iterable[Iterable[object]],
) -> None:
    """Create, populate, and style a worksheet."""
    worksheet = workbook.create_sheet(title)
    _append_excel_row(worksheet, headers)
    for row in rows:
        _append_excel_row(worksheet, row)
    _style_sheet(worksheet)


def _summary_rows(result: TenderAnalysisResult) -> list[list[object]]:
    """Build the tender's parameter summary rows."""
    rows: list[list[object]] = []
    findings = sorted(result.findings, key=lambda finding: finding.parameter_number)

    for finding in findings:
        rows.append([
            finding.parameter_number,
            finding.parameter_name,
            finding.status.value,
            display_missing_value(finding.requirement_summary),
            display_missing_value(finding.costing_impact),
            finding.risk_level.value,
            display_missing_value(_source_pages(finding)),
            display_missing_value(_source_documents(finding)),
            "Yes" if finding.review_required else "No",
            finding.review_reason or "",
        ])
    return rows


def _boq_rows(items: Iterable[BOQItem]) -> list[list[object]]:
    """Build BOQ rows from extracted candidate items."""
    rows: list[list[object]] = []
    for item in items:
        rows.append([
            display_missing_value(item.item_number),
            display_missing_value(item.description),
            float(item.quantity) if item.quantity is not None else MISSING_VALUE,
            display_missing_value(item.unit),
            float(item.unit_price) if item.unit_price is not None else MISSING_VALUE,
            float(item.total_price) if item.total_price is not None else MISSING_VALUE,
            display_missing_value(item.source_filename),
            display_missing_value(item.source_page),
            "Yes" if item.review_required else "No",
            display_missing_value(item.review_reason),
        ])
    return rows


def _risk_rows(result: TenderAnalysisResult) -> list[list[object]]:
    """Include findings flagged for manual review."""
    rows: list[list[object]] = []
    for finding in result.findings:
        if not finding.review_required:
            continue
        rows.append([
            finding.parameter_name,
            finding.status.value,
            finding.risk_level.value,
            display_missing_value(finding.review_reason or "Manual review required."),
            display_missing_value(_source_documents(finding)),
            display_missing_value("; ".join(str(item.page_number) for item in finding.evidence)),
            "Yes",
        ])
    return rows


def _evidence_rows(result: TenderAnalysisResult) -> list[list[object]]:
    """Export source excerpts alongside their parameter context."""
    rows: list[list[object]] = []
    for finding in result.findings:
        if not finding.evidence:
            rows.append([
                finding.parameter_name,
                MISSING_VALUE,
                MISSING_VALUE,
                MISSING_VALUE,
                MISSING_VALUE,
                finding.status.value,
                display_missing_value(finding.review_reason),
            ])
            continue

        for evidence in finding.evidence:
            rows.append([
                finding.parameter_name,
                display_missing_value(evidence.filename),
                evidence.page_number,
                display_missing_value(evidence.clause_reference),
                display_missing_value(evidence.quoted_text),
                finding.status.value,
                display_missing_value(finding.review_reason),
            ])
    return rows


